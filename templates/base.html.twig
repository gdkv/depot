<!DOCTYPE html>
<html data-symfony-ux-translator-locale="{{ app.locale }}">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Депо. Умная система мониторинга микроклимата в любом помешении{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <main id="panel" class="welcome">
        <header>
            <div class="logo">
                <a href="{{ path('app.index') }}"><img src="{{ asset('/build/images/depo.svg') }}"  alt=""/></a>
            </div>

            <nav>
                <a href="{{ path('app.app') }}">{{ 'main.menu.app' | trans }}</a>
                <a href="{{ path('app.buy') }}">{{ 'main.menu.buy' | trans }}</a>
                <a href="{{ path('app.about') }}">{{ 'main.menu.about' | trans }}</a>
                <a href="{{ path('app.download') }}">{{ 'main.menu.downloads' | trans }}</a>
            </nav>
        </header>

        {% block content %}{% endblock %}

        <aside>
            <div {{ vue_component('components/auth/Login') }}></div>
        </aside>

        <div class="cookie">
            <div class="cookie-icon">
                <img src="{{ asset('/build/images/cookie.png') }}" alt="" />
            </div>
            <div class="cookie-text">
                {{ 'main.cookie.info' | trans }} <a href="">{{ 'main.cookie.link' | trans }}</a>
            </div>
            <div class="cookie-close">
                <img src="{{ asset('/build/images/cross.svg') }}" alt="" />
            </div>
        </div>
    </main>
</html>
